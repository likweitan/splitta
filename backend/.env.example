# Set this to a vision-capable model deployed through SAP AI Core Orchestration.
AICORE_MODEL=

# For local development, provide an AI Core service key:
# AICORE_SERVICE_KEY='{"clientid":"...","clientsecret":"...","url":"...","serviceurls":{"AI_API_URL":"..."}}'
#
# Alternatively, use `cds bind -2 <AI_CORE_INSTANCE>` and run with the hybrid profile.

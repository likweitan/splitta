{
  "name": "backend",
  "version": "1.0.0",
  "packageManager": "bun@1.4.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap-ai-sdk/orchestration": "^2.18.0",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
